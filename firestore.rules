rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: Is de gebruiker ingelogd?
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper: Is de gebruiker een admin?
    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.email == "abdelbouda@gmail.com" || 
        request.auth.token.email == "info@mijnzorgzuster.nl" ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
      );
    }

    // Helper: Is de gebruiker een ZZP?
    function isZZP() {
      return isAuthenticated() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'zzp';
    }

    // Klanten (Clients) regels
    match /clients/{clientId} {
      allow read: if isAuthenticated(); 
      allow write: if isAdmin();
    }

    // Opdrachten (Assignments) regels
    match /assignments/{assignmentId} {
      allow read: if isAdmin() || (isAuthenticated() && resource.data.uid == request.auth.uid);
      allow write: if isAdmin();
    }

    // Urenregistraties regels
    match /timeRegistrations/{id} {
      allow read: if isAdmin() || (isAuthenticated() && resource.data.uid == request.auth.uid);
      allow create: if isAuthenticated() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if isAdmin() || (isAuthenticated() && resource.data.uid == request.auth.uid && resource.data.status != 'approved');
    }

    // Gebruikersprofielen - met query support voor password reset
    match /users/{userId} {
      // ZZP'ers mogen list/query gebruiken voor wachtwoord reset (aligned met resetPassword.ts backend)
      // Admins mogen ook lezen voor user management
      allow list: if isAdmin() || isZZP();
      
      // Get: jezelf of admin mag je profiel zien
      allow get: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      
      // Write: alleen admins mogen wijzigingen maken
      allow write: if isAdmin();
    }
  }
}
